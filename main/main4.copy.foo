//   record: @type @rec(
//     member: @rec(fnptr: @fn(s32;s32)(@fn(s32;s32)(s32)));
//   );
//   record::member::fnptr(arg0; arg1)(arg2; arg3);
// };

// //failure
// {
//   record::member::fnptr(arg0; arg1)(arg2; arg3);
// };

fnptr: @type @fn(s32)(s32);

A: @type @rec(
  B: @imut fnptr;
);


fail: @type @tup(s32; s32);

