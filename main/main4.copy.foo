// fn: math_alias::fn = a + b;
// fnp: math_alias::fnptr = 10;

// math_alias: @alias math;

// record: @type @rec(
//   self: *record;
// );

// math: @mod(
//   fn: @type @fn(a: num; b: num)(num);
//   fnptr: @type @fn(num; num)(num);
//   num: @type s32;

//   self: @alias @::math_alias;
// );


// allocator interface
allocator_vtable: @mod (
 impl: @mod(
   mem_alloc: @type @fn(self: *t; size: u64; alignment: u64)(@ptr);
   mem_realloc: @type @fn(self: *t; size: u64; alignment: u64)(@ptr);
 );

 t: @type @rec(
   impl_ptr: @ptr;
   alloc: *impl::mem_alloc;
   realloc: *impl::mem_realloc;
 );
);


slice: @mod{T: @type}(

  t: @type @rec(
    begin: ~T;
    end: ~T;
  );

  at: @fn(s: @imut t; index: u64)(~T) =
    s::begin + index;

  size: @fn(s: t)(u64) =
    @as(u64)s::begin - @as(u64)s::end / @sizeof{~T};

  find: @fn(s: t; val: ~@imut T) (u64) = (10);
);

// // change that to use templates
darray: @mod{Elm: @type}(
  type: @mod(
    slice: @type @tup(type::elm_ptr; type::elm_ptr);
    size: @type u32;
    elm_ptr: @type *Elm;
  );

  t: @type @rec(
    length: type::size;
    capacity: type::size;
    data: type::elm_ptr;

    alloc: allocator_vtable::t;
  );

  alloc: @fn(size: type::size)(type::size) = ();
  realloc: @fn(self: *t; size: type::size)(type::size) = ();
  dealloc: @fn(self: *t)(type::size) = ();

  push: @fn(self: *t; value: type::elm_ptr)(type::elm_ptr) = ();
  push_array: @fn(self: *t; begin: type::elm_ptr; end: type::elm_ptr)(type::slice) = ();
);

archipelago: @mod (
  // change that to darray{island}
  islands_t: @type darray::type::size;

  t: @type @rec(
    islands: islands_t;
  );
);

island: @mod{Elm: @type}(
  type: @mod(
    elm_ptr: @type *Elm;
  );

  t: @type @rec(
    cursor: type::elm_ptr;
    begin: type::elm_ptr;
    end: type::elm_ptr;
  );

  allocate: @fn(size: u64; alignment: u64; self: *t)(type::elm_ptr) = (
    // for now skip alignment calculations
    cursor: *u8 = self::cursor;
    end: *u8 = self::end;

    @if(cursor + size >= end)
      (@ret @null);

    ptr: type::elm_ptr = cursor; self::cursor = cursor + size;
    @ret ptr;
  );

  reset: @fn(self: *t)(@void) =
   self::cursor = self::begin;

  size: @fn(self: *t)(u64) =
    self::cursor - self::begin;

  capacity: @fn(self: *t)(u64) =
    self::end - self::begin;
);

