std: @mod(
  mono: @mod (
    t: @type @rec();
    make: @fn() t = @();
  );

  empty: @type mono::t;
  make_empty: @alias mono::make;

  result: @mod{T: @type} (
    t: @type @var(
      value: T;
      empty: mono::t;
    );
  );
);

fnt: @type
  @fn*(s32; s32; s32) s32;

fnt2: @type
  @fn(a: s32; b: s32) @var(ok: f128; err: std::mono::t);

fnt3: @type
  @fn(a: s32; b: s32) @void;

alloc: @mod(
  malloc_ft:     @type @fn(ctx: @ptr; size: u64; alignment: u64)  @ptr;
  realloc_ft:    @type @fn(ctx: @ptr; ptr: @ptr; newsize: u64) @ptr;
  free_ft:       @type @fn(ctx: @ptr; ptr: @ptr) @void;

  malloc_ftype:  @type @fn*(@ptr; u64; u64) @ptr;
  realloc_ftype: @type @fn*(@ptr; @ptr; u64) @ptr;
  free_ftype:    @type @fn*(@ptr; @ptr) @void;

  vtable: @type @rec(
    malloc:    malloc_ftype;
    realloc:   realloc_ftype;
    free:      free_ftype;
  );

  t: @type @rec(
    impl: @ptr;  // opaque pointer to the allocator
    v: ~vtable;  // pointer to the global vtable
  );
);

libc: @mod(
  alloc: @mod(
    t: @type @rec();

    malloc: @::alloc::malloc_ft =
      libc::malloc(size; alignment);

    realloc: @::alloc::realloc_ft =
      libc::realloc(ptr; size; alignment);

    free: @::alloc::free_ft =
      libc::free(ptr);

    vtable: @const @::alloc::vtable =
      @(malloc; realloc; free);
  );
);

arena: @mod (
  t: @type @rec(
   data: *u8;
   offset: u64;
   capacity: u64;
  );

  next: @fn(arena: ~ @imut t) @ptr =
    arena::data + arena::offset;

  reset: @fn(arena: ~t) @void =
    arena::offset = 0;

  malloc: @::alloc::malloc_ft = (
    arena: ~t = @as(~t)ctx;

    @if(arena::offset + size > arena::capacity)
      (@ret @null);

    new: @ptr = next(arena);
    arena::offset += size;

    @ret new;
  );

  realloc: @::alloc::realloc_ft = (@unreachable);
  free: @::alloc::free_ft = (@unreachable);

  vtable: @const @::alloc::vtable = @(malloc; realloc; free);

  allocator: @fn(arena: ~t) @::alloc::t =
    @(@as(@ptr)arena; &vtable);
);

vector: @mod{T: @type}(
  t: @type @rec(
    begin:  *T;
    end:    *T;
    cursor: *T;

    allocator: alloc::t;
  );

  it: @type @rec(
    data: ~T;
  );

  make: @fn(allocator: @::alloc::t; capacity: u64) @var(success: t; error: std::empty) = (
    alignment: u64 = alignof(T);
    ptr: *T = allocator::alloc(allocator; capacity; alignment);

    @ret @if(ptr)
            (@(success := @(ptr; ptr + capacity; ptr; allocator)))
            (@(fail := @::std::mono::make()));
  );

  size: @fn(self: ~t) u64 =
    self::begin - self::cursor;

  capacity: @fn(self: ~t) u64 =
    self::begin - self::end;

  push: @fn(self: ~t; value: T) @var(success: ~T; fail: std::empty) = (
    csize: @imut u64 = size(self);
    ccap: @imut u64 = capacity(self);

    @if(csize + 1 > ccap)(
      newptr := grow(self; csize*2)
    );

    self::cursor = value;
    self::cursor += 1;

    // @memcpy(ptr; ptr; size);
    
    @ret @(success := ptr);
  );
);


variant: @type @var(
    a: s32;
    b: f32;
);

record: @type @rec(
    a: s32;
    b: f32;
);

function: @fn(a: s32; b: s32) s32 = (
    value := (
      value0 :=
        @as(s32)(10 + 20);

      value1 :=
        @(10; 20; 30);

      value2 :=
        @(a := 10);

      @break value2;
    );

    10*20 -> @pipe;

    a: s32 = 10 + 1.0;

    @ret 10;
);

std: @mod(
    allocator: @mod(
        vtable: @type @rec(
            malloc: @ptr;
            realloc: @ptr;
            free: @ptr;    
        );
        ptr: @type @ptr;


        t: @type @rec(
            p: ptr;
            table: ~vtable;
        );
    );  
);

func: @fn(alloc: std::allocator::t; a: s32; b: s32) @var(success: @ptr; err: std::empty) = 
    @if(a > 10)(
        @ret @(success := @null);
    ) (a == 2) (
        @ret @(success := @null);
    ) (
        @ret @(err := @());
    );

list: @mod{Elm: @type}(
    pointer: @type *Elm;
    ref: @type ~Elm;
    
    t: @type @rec(
        data: pointer;
        len: u32;
        cap: u32;
    );

    it: @type pointer;

    result: @type @var(success: it; err: std::empty);
    
    push: @fn(alloc: std::allocator::t; self: ~t; v: Elm) result = ();
    insert: @fn(alloc: std::allocator::t; self: ~t; v: Elm; index: u32) result= ();

    pop: @fn(self: ~t) @void = 
        @if(self::len > 0)(self::len = self::len - 1);

    at: @fn(self: ~t; index: u32) result = 
        @if(index >= self::len) (
            @ret @(err := @())
        ) (
            @ret @(success := self::data + index);
        );
);

(
    u32darray: @alias list;
    var := u32darray::push(alloc; l; 10);
    // @match(var)(
    //     (it: success)
    //         it;
    //     (err)
    //         @null;
    // );
);



