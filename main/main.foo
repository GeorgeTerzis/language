// fn: @fn(s32; s32)(s32);

math: @mod{Num: @type}(
  Fn: @type f32;
  dir: @fn(x: Num; h: Num; fn: Fn)(Num) =
    (fn(x + h) - fn(x - h))/(2*h);
);

f32math: @alias math{f32};
 // f64math: @alias math{f64};
 // s32math: @alias math{s32}; //error

 // fvec: @alias vec{f32};
 h: f32 = 0.001;

 // @for(elm: @imut = fvec::begin(vec); elm != fvec::end(vec); elm++)(
 //   f32math::dir(elm; h; function) -> fvec::push_assume_size(@pipe; out);
 // );


memblock: @mod{T: @type} (
  t: @type @rec(
    capacity: u64;
    data: ^T;
  );
);


node: @type @rec(
  data: s32;
  next: ^node;
);

list: @mod{T: @type} (
  t: @type @rec(
    length: u32;
    data: memblock::t;
  );

  make: @fn(capacity: s32; mem: memblock::t)(t) =
    @(0; mem);

  capacity: @fn(self: ^t)(s32) =
    self::data::capacity;

  length: @fn(self: ^t)(s32) =
    self::length;

  next_capacity: @fn(self: ^t)(s32) =
    capacity(self)* 2;

  next_length: @fn(offset: s32; self: ^t)(s32) =
    length(self) + 1;
  
  write: @fn(value: ~t; count: s32; self: ^t)(^t) = 
    self::data::data + length(self) -> @::c::memcpy(self; value; sizeof_T* count);

  push: @fn(value: ~t; count: s32; self: ^t)(^t) =
    @if (next_length(self; count) >= capacity(self))
      (expand(self; next_capacity(self))) ->
    write(self; value; count);
);

bump: @mod(
  t: @type @rec(
    cursor: @ptr;
    begin: @ptr;
    end: @ptr;
  );

  allocate: @fn(size: u64; alignment: u64; self: ^t)(@ptr) = {
    // for now skip alignment calculations
    cursor: ^u8 = self::cursor;
    end: ^u8 = self::end;

    @if(cursor + size >= end)
      (@ret @null);

    ptr: @ptr = cursor; self::cursor = cursor + size;
    @ret ptr;
  };

  reset: @fn(self: ^t)(@void) =
   self::cursor = self::begin;

  size: @fn(self: ^t)(u64) =
    self::cursor - self::begin;

  capacity: @fn(self: ^t)(u64) =
    self::end - self::begin;
);

function2: function = a + b;
function: @fn(a: s32; b: s32)(s32) = a + b;

module_template: @mod{T: @type} (
  function: @fn(a: s32; b: s32)(s32) = a + b;
);

// alias: @alias module_template{something}::function;
something: @type s32;


